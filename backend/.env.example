# ===== KIS Open API =====
# 발급: 한투 홈페이지 > 트레이딩 > Open API > KIS Developers
# 실전/모의 키가 각각 따로 발급됨. MODE에 맞는 키를 넣을 것.
KIS_APP_KEY=your-app-key
KIS_APP_SECRET=your-app-secret
KIS_ACCOUNT_NO=12345678-01       # 계좌번호 (앞 8자리-뒤 2자리)

# mock = 모의투자 서버(openapivts), real = 실전투자 서버(openapi)
KIS_MODE=mock

# ===== 서버 =====
PORT=4000
# 데이터 없이 프론트 먼저 붙일 때: true면 KIS 호출 없이 가짜 데이터로 동작
MOCK_DATA=true

# 프론트-백엔드 간 인증용 (임의의 긴 문자열)
API_AUTH_TOKEN=change-me-to-a-long-random-string
