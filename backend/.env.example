# ===== KIS Open API =====
# 발급: 한투 홈페이지 > 트레이딩 > Open API > KIS Developers
# 실전/모의 키가 각각 따로 발급됨. MODE에 맞는 키를 넣을 것.
KIS_APP_KEY=your-app-key
KIS_APP_SECRET=your-app-secret
KIS_ACCOUNT_NO=12345678-01       # 계좌번호 (앞 8자리-뒤 2자리)

# mock = 모의투자 서버(openapivts), real = 실전투자 서버(openapi)
KIS_MODE=mock

# ===== 서버 =====
PORT=4000
# 데이터 없이 프론트 먼저 붙일 때: true면 KIS 호출 없이 가짜 데이터로 동작
MOCK_DATA=true

# 프론트-백엔드 간 인증용 (임의의 긴 문자열)
API_AUTH_TOKEN=change-me-to-a-long-random-string

# ===== 계정·자격증명 금고 (docs/accounts.md) =====
# 로그인한 사용자의 Upbit/KIS 키를 AES-256-GCM으로 암호화해 볼륨에 저장한다.
# openssl rand -hex 32 — 없으면 금고 잠김(키 저장 API 503). 바꾸면 기존 암호문은 못 연다.
CREDENTIALS_MASTER_KEY=
# first = 첫 사용자(owner)만 가입 가능, true = 누구나
SIGNUP_OPEN=first

# 허용 CORS 오리진 (콤마 구분) — 배포 시 대시보드 도메인 추가
CORS_ORIGINS=http://localhost:3000

# ===== 자동매매 (기본 전부 OFF) =====
# 파이프라인 실행 신호 → 주문 실행. 켜도 모든 주문은 riskManager 관문을 지난다.
AUTO_TRADE=false
# 실모드(KIS_MODE=real + MOCK_DATA=false)에서 자동매매를 허용하는 명시적 이중 스위치.
# 이 플래그 없이 실모드에서 켜려 하면 거부된다.
AUTO_TRADE_ALLOW_REAL=false

# ===== 크립토 (Upbit) =====
# 시세/캔들/백테스트는 키 없이 공개 API로 항상 실데이터. 키는 계좌/실주문에만.
UPBIT_ACCESS_KEY=
UPBIT_SECRET_KEY=
# 크립토 신호 → 주문. 기본 true(페이퍼 장부 — 라이브 기록 축적). 실주문은 ALLOW_REAL+키 필요
CRYPTO_TRADE=true
# 실제 Upbit 주문까지 허용하는 명시적 이중 스위치 (키 + 이 플래그 둘 다 필요)
CRYPTO_TRADE_ALLOW_REAL=false
# 알트코인 스캐너 자동 로테이션 (24h 주기). 페이퍼 장부 전용 — 실주문 모드에서는
# 로테이션 자체가 거부된다 (페이퍼 기록으로 증명이 먼저).
CRYPTO_SCANNER=false

# ===== 증권 오피스 결정 루프 (docs/office-loop.md) =====
# Handsel MCP — 기본 테스트넷. 메인넷(handsel-main)은 OFFICE_ALLOW_REAL_MONEY=true 필요
HANDSEL_MCP_URL=https://handsel-nu.vercel.app/api/mcp
HANDSEL_MCP_TOKEN=            # POST /api/oauth/personal-token → lmk_…
HANDSEL_PRIME_AGENT_ID=       # escrow를 내는 에이전트 id
OFFICE_LOOP=false             # true면 OFFICE_INTERVAL_H마다 자동 사이클 (페이퍼 매매)
OFFICE_BUDGET_USD=10             # securities-floor 9단계 × 최소 $1 (테스트넷 USDC)
OFFICE_INTERVAL_H=24
OFFICE_ALLOW_REAL_MONEY=false

# ===== MCP 워커 (Handsel office 탈부착) =====
# POST /mcp 인증 토큰 — Handsel connect_mcp_worker의 auth_header에
# "Bearer <이 값>"을 넣는다. 비우면 API_AUTH_TOKEN을 재사용.
MCP_AUTH_TOKEN=
# true일 때만 MCP에 주문/자동매매 툴(us_place_order, us_auto_trade) 노출.
# 기본 false = 읽기 전용 워커 (시세/파이프라인/감성/잔고 리포트만).
MCP_TRADING=false
